{
    "name": "qa-agent-mcp",
    "version": "1.0.0",
    "description": "QA Agent MCP Server for WDIO + Cucumber + Azure DevOps orchestration",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node-esm src/index.ts",
        "build": "tsc && node scripts/copy-assets.mjs",
        "start:stdio": "MCP_MODE=stdio node dist/index.js",
        "start": "node dist/index.js",
        "lint": "eslint src --ext .ts",
        "clean": "rm -rf dist qa-logs"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.25.3",
        "axios": "^1.13.4",
        "azure-devops-node-api": "^13.0.0",
        "dotenv": "^16.6.1",
        "express": "^4.22.1",
        "pixelmatch": "^5.3.0",
        "pngjs": "^7.0.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/express": "^4.17.25",
        "@types/node": "^20.19.32",
        "eslint": "^9.0.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=18"
    }
}
